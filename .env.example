# Soroban Contract Configuration
NEXT_PUBLIC_CONTRACT_ID=YOUR_POLL_CONTRACT_ID
NEXT_PUBLIC_REWARD_TOKEN_ID=YOUR_REWARD_TOKEN_CONTRACT_ID
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Alibaba DashScope API (for AI Vote Insight panel — Qwen model)
API_KEY=your_dashscope_api_key_here

# Anthropic API (for Multi-Agent assistant on /agent — Haiku router + Sonnet analytics)
ANTHROPIC_API_KEY=

# AMM DEX Contracts (deploy with: node scripts/deploy-amm.js)
NEXT_PUBLIC_AMM_CONTRACT_ID=YOUR_AMM_CONTRACT_ID
NEXT_PUBLIC_LP_TOKEN_ID=YOUR_LP_TOKEN_CONTRACT_ID
NEXT_PUBLIC_TOKEN_A_ID=YOUR_TOKEN_A_CONTRACT_ID
NEXT_PUBLIC_TOKEN_B_ID=YOUR_TOKEN_B_CONTRACT_ID

# Fee Bump Sponsor (server-side only — never expose to client)
# Generate: node -e "const S=require('@stellar/stellar-sdk');const k=S.Keypair.random();console.log('Public:',k.publicKey());console.log('Secret:',k.secret());"
# Fund on testnet: https://friendbot.stellar.org/?addr=YOUR_PUBLIC_KEY
FEE_BUMP_SPONSOR_SECRET=YOUR_SPONSOR_SECRET_KEY
FEE_BUMP_SPONSOR_PUBLIC=YOUR_SPONSOR_PUBLIC_KEY
